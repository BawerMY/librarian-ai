# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and the template is opted in: a clone has no other record of which
# variables exist, and env.ts throws at boot on a missing one.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data — uploaded books and the cached Gutenberg catalog.
# .data/uploads holds users' own copyrighted EPUBs until they are indexed;
# committing them would redistribute exactly what the app is careful not to.
/.data/
