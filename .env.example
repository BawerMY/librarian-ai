# --- Postgres (docker compose) ---
DATABASE_URL=postgres://postgres@127.0.0.1:5432/librarian

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Collection name encodes the embedding model. NEVER use a bare "chunks":
# swapping the embed model means a new collection, not a mutated one.
QDRANT_COLLECTION=chunks_bge_en_v1

# --- Ollama — embeddings only ---
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-large
EMBED_DIM=1024
# bge-large's context window. Chunking must stay under this.
EMBED_MAX_TOKENS=512

# --- Chat inference (OpenRouter via AI SDK registry) ---
OPENROUTER_API_KEY=
# provider:model — swap provider with no code change
CHAT_MODEL=openrouter:qwen/qwen3.8-flash
CHAT_MODEL_FALLBACK=qwen/qwen3.7-flash

# --- Auth.js ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# --- OAuth (optional; dev sign-in works without it) ---
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=


# --- Local storage for uploaded books (deleted after indexing) ---
UPLOAD_DIR=./.data/uploads

# --- Admin panel (separate from user accounts; /admin) ---
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12
